
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String               @id @default(uuid()) @db.Char(36)
  name                   String               @db.VarChar(191)
  email                  String               @unique @db.VarChar(191)
  emailVerified          Boolean              @default(false) @map("email_verified")
  image                  String?              @db.Text
  status                 String               @default("active") @db.VarChar(32)
  developerModeEnabled   Boolean              @default(false) @map("developer_mode_enabled")
  developerModeEnabledAt DateTime?            @map("developer_mode_enabled_at")
  planId                 String               @default("free") @map("plan_id") @db.VarChar(32)
  polarCustomerId        String?              @map("polar_customer_id") @db.VarChar(191)
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  sessions               Session[]
  providerConfigs        ProviderConfig[]
  oauthStates            OauthState[]
  connectedAccounts      ConnectedAccount[]
  files                  File[]
  fileShares             FileShare[]
  filePreviewTokens      FilePreviewToken[]
  folders                Folder[]
  uploadSessions         UploadSession[]
  auditLogs              AuditLog[]
  workspaceInvitesSent   WorkspaceInvite[]    @relation("WorkspaceInvitesSent")
  uploadRoutingPolicy    UploadRoutingPolicy?
  apiKeys                ApiKey[]
  accounts               Account[]
  transferJobs           TransferJob[]
  transferUsageMonths    TransferUsageMonth[]
  tags                   Tag[]
  scheduledTransfers    ScheduledTransfer[]
  folderSyncs           FolderSync[]
  virtualFolders        VirtualFolder[]
  billingSubscriptions  BillingSubscription[]
  newsletterSubscriber  NewsletterSubscriber?

  @@index([polarCustomerId])
  @@map("users")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid()) @db.Char(36)
  userId         String?   @unique @map("user_id") @db.Char(36)
  email          String    @unique @db.VarChar(191)
  subscribed     Boolean   @default(true)
  source         String    @default("signup") @db.VarChar(64)
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscribed, createdAt])
  @@map("newsletter_subscribers")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @map("user_id") @db.Char(36)
  name       String    @db.VarChar(191)
  keyPrefix  String    @map("key_prefix") @db.VarChar(32)
  keyHash    String    @unique @map("key_hash") @db.VarChar(255)
  scopes     Json
  status     String    @default("active") @db.VarChar(32)
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("api_keys")
}

model BillingSubscription {
  id                   String    @id @default(uuid()) @db.Char(36)
  userId               String    @map("user_id") @db.Char(36)
  polarSubscriptionId  String    @unique @map("polar_subscription_id") @db.VarChar(191)
  polarProductId       String    @map("polar_product_id") @db.VarChar(191)
  planId               String    @map("plan_id") @db.VarChar(32)
  status               String    @db.VarChar(64)
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("billing_subscriptions")
}

model UploadRoutingPolicy {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @unique @map("user_id") @db.Char(36)
  mode               String   @default("most_available") @db.VarChar(32)
  priorityAccountIds Json     @map("priority_account_ids")
  roundRobinCursor   Int      @default(0) @map("round_robin_cursor")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upload_routing_policies")
}

model ProviderConfig {
  id                    String             @id @default(uuid()) @db.Char(36)
  userId                String?            @map("user_id") @db.Char(36)
  provider              String             @db.VarChar(32)
  clientIdEncrypted     String             @map("client_id_encrypted") @db.Text
  clientSecretEncrypted String             @map("client_secret_encrypted") @db.Text
  redirectUri           String             @map("redirect_uri") @db.Text
  scopes                Json
  status                String             @default("active") @db.VarChar(32)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  user                  User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  oauthStates           OauthState[]
  connectedAccounts     ConnectedAccount[]

  @@index([userId])
  @@index([provider])
  @@map("provider_configs")
}

model OauthState {
  id               String         @id @default(uuid()) @db.Char(36)
  userId           String?        @map("user_id") @db.Char(36)
  providerConfigId String         @map("provider_config_id") @db.Char(36)
  flow             String         @default("connect") @db.VarChar(32)
  stateHash        String         @unique @map("state_hash") @db.VarChar(255)
  expiresAt        DateTime       @map("expires_at")
  usedAt           DateTime?      @map("used_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_states")
}

model ConnectedAccount {
  id                    String           @id @default(uuid()) @db.Char(36)
  userId                String           @map("user_id") @db.Char(36)
  providerConfigId      String?          @map("provider_config_id") @db.Char(36)
  provider              String           @db.VarChar(32)
  providerAccountId     String           @map("provider_account_id") @db.VarChar(191)
  email                 String           @db.VarChar(191)
  displayName           String?          @map("display_name") @db.VarChar(191)
  avatarUrl             String?          @map("avatar_url") @db.Text
  accessTokenEncrypted  String?          @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?          @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime?        @map("token_expires_at")
  scopes                Json
  status                String           @default("connected") @db.VarChar(32)
  lastError             String?          @map("last_error") @db.Text
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConfig        ProviderConfig?  @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  storageAccount        StorageAccount?
  files                 File[]
  folders               Folder[]
  uploadSessions        UploadSession[]
  transferJobsFrom      TransferJob[]      @relation("TransferJobSourceAccount")
  transferJobsTo        TransferJob[]      @relation("TransferJobDestAccount")
  scheduledTransfersFrom ScheduledTransfer[] @relation("ScheduledTransferSourceAccount")
  scheduledTransfersTo   ScheduledTransfer[] @relation("ScheduledTransferDestAccount")
  folderSyncsFrom        FolderSync[]        @relation("FolderSyncSourceAccount")
  folderSyncsTo          FolderSync[]        @relation("FolderSyncDestAccount")
  virtualFolderItems     VirtualFolderItem[]
  webhookChannels        ProviderWebhookChannel[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
  @@index([userId, status, createdAt])
  @@map("connected_accounts")
}

model StorageAccount {
  id                 String           @id @default(uuid()) @db.Char(36)
  connectedAccountId String           @unique @map("connected_account_id") @db.Char(36)
  totalBytes         BigInt?          @map("total_bytes")
  usedBytes          BigInt           @default(0) @map("used_bytes")
  availableBytes     BigInt?          @map("available_bytes")
  trashBytes         BigInt?          @map("trash_bytes")
  photoBytes         BigInt           @default(0) @map("photo_bytes")
  videoBytes         BigInt           @default(0) @map("video_bytes")
  documentBytes      BigInt           @default(0) @map("document_bytes")
  breakdownSyncedAt  DateTime?        @map("breakdown_synced_at")
  lastSyncedAt       DateTime?        @map("last_synced_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@map("storage_accounts")
}

model File {
  id                 String             @id @default(uuid()) @db.Char(36)
  userId             String             @map("user_id") @db.Char(36)
  connectedAccountId String             @map("connected_account_id") @db.Char(36)
  folderId           String?            @map("folder_id") @db.Char(36)
  provider           String             @db.VarChar(32)
  providerFileId     String             @map("provider_file_id") @db.VarChar(191)
  name               String             @db.VarChar(255)
  mimeType           String             @map("mime_type") @db.VarChar(191)
  sizeBytes          BigInt             @map("size_bytes")
  checksum           String?            @db.VarChar(191)
  status             String             @default("active") @db.VarChar(32)
  isStarred          Boolean            @default(false) @map("is_starred")
  starredAt          DateTime?          @map("starred_at")
  isArchived         Boolean            @default(false) @map("is_archived")
  archivedAt         DateTime?          @map("archived_at")
  lastAccessedAt     DateTime?          @map("last_accessed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount   @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  folder             Folder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares             FileShare[]
  previewTokens      FilePreviewToken[]
  fileTags           FileTag[]

  @@index([userId])
  @@index([userId, status, createdAt])
  @@index([userId, status, folderId, createdAt])
  @@index([userId, status, isStarred, starredAt])
  @@index([userId, status, isArchived, archivedAt])
  @@index([userId, status, lastAccessedAt])
  @@index([connectedAccountId])
  @@index([folderId])
  @@index([providerFileId])
  @@map("files")
}

model Tag {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  name      String    @db.VarChar(64)
  color     String    @default("text-blue-500") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileTags  FileTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model FileTag {
  id        String   @id @default(uuid()) @db.Char(36)
  fileId    String   @map("file_id") @db.Char(36)
  tagId     String   @map("tag_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([fileId, tagId])
  @@index([tagId])
  @@index([fileId])
  @@map("file_tags")
}

model TransferJob {
  id                   String            @id @default(uuid()) @db.Char(36)
  userId               String            @map("user_id") @db.Char(36)
  type                 String            @db.VarChar(32)
  status               String            @default("queued") @db.VarChar(32)
  sourceAccountId      String            @map("source_account_id") @db.Char(36)
  destAccountId        String            @map("dest_account_id") @db.Char(36)
  sourceProviderFileId String            @map("source_provider_file_id") @db.VarChar(191)
  destProviderFileId   String?           @map("dest_provider_file_id") @db.VarChar(191)
  destParentId         String?           @map("dest_parent_id") @db.VarChar(191)
  fileName             String            @map("file_name") @db.VarChar(255)
  mimeType             String            @map("mime_type") @db.VarChar(191)
  sizeBytes            BigInt            @default(0) @map("size_bytes")
  transferredBytes     BigInt            @default(0) @map("transferred_bytes")
  errorMessage         String?           @map("error_message") @db.Text
  startedAt            DateTime?         @map("started_at")
  completedAt          DateTime?         @map("completed_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount        ConnectedAccount  @relation("TransferJobSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  destAccount          ConnectedAccount  @relation("TransferJobDestAccount", fields: [destAccountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([sourceAccountId])
  @@index([destAccountId])
  @@map("transfer_jobs")
}

model TransferUsageMonth {
  id               String   @id @default(uuid()) @db.Char(36)
  userId           String   @map("user_id") @db.Char(36)
  yearMonth        String   @map("year_month") @db.VarChar(7)
  transferredBytes BigInt   @default(0) @map("transferred_bytes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth])
  @@index([userId])
  @@map("transfer_usage_months")
}

model ScheduledTransfer {
  id                 String   @id @default(uuid()) @db.Char(36)
  userId             String   @map("user_id") @db.Char(36)
  status             String   @default("active") @db.VarChar(32)
  operation          String   @default("copy") @db.VarChar(32)
  scheduleKind       String   @map("schedule_kind") @db.VarChar(16)
  nextRunAt          DateTime @map("next_run_at")
  lastRunAt          DateTime? @map("last_run_at")
  completedAt        DateTime? @map("completed_at")
  errorMessage       String?  @map("error_message") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  sourceAccountId      String   @map("source_account_id") @db.Char(36)
  destAccountId        String   @map("dest_account_id") @db.Char(36)
  destParentId         String?  @map("dest_parent_id") @db.VarChar(191)

  sourceProviderFileId String  @map("source_provider_file_id") @db.VarChar(191)
  fileName             String  @map("file_name") @db.VarChar(255)
  mimeType             String  @map("mime_type") @db.VarChar(191)
  sizeBytes            BigInt  @map("size_bytes") @default(0)

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount ConnectedAccount @relation("ScheduledTransferSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  destAccount   ConnectedAccount @relation("ScheduledTransferDestAccount", fields: [destAccountId], references: [id], onDelete: Cascade)

  @@index([userId, status, nextRunAt])
  @@index([nextRunAt])
  @@map("scheduled_transfers")
}

model FolderSync {
  id              String   @id @default(uuid()) @db.Char(36)
  userId          String   @map("user_id") @db.Char(36)
  status          String   @default("active") @db.VarChar(32)
  direction       String   @default("one_way") @db.VarChar(32)
  sourceAccountId String   @map("source_account_id") @db.Char(36)
  destAccountId   String   @map("dest_account_id") @db.Char(36)
  sourceParentId  String   @default("root") @map("source_parent_id") @db.VarChar(512)
  destParentId    String   @default("root") @map("dest_parent_id") @db.VarChar(512)
  sourceLabel     String?  @map("source_label") @db.VarChar(191)
  destLabel       String?  @map("dest_label") @db.VarChar(191)
  scheduleKind    String   @default("manual") @map("schedule_kind") @db.VarChar(32)
  pollEnabled     Boolean  @default(false) @map("poll_enabled")
  lastContentHash String?  @map("last_content_hash") @db.VarChar(128)
  lastPolledAt    DateTime? @map("last_polled_at")
  nextRunAt       DateTime? @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  lastError       String?  @map("last_error") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount   ConnectedAccount @relation("FolderSyncSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  destAccount     ConnectedAccount @relation("FolderSyncDestAccount", fields: [destAccountId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, nextRunAt])
  @@map("folder_syncs")
}

model ProviderWebhookChannel {
  id                 String           @id @default(uuid()) @db.Char(36)
  connectedAccountId String           @map("connected_account_id") @db.Char(36)
  provider           String           @db.VarChar(32)
  channelId          String           @map("channel_id") @db.VarChar(191)
  resourceId         String?          @map("resource_id") @db.VarChar(191)
  channelToken       String           @map("channel_token") @db.VarChar(191)
  pageToken          String?          @map("page_token") @db.VarChar(512)
  expirationAt       DateTime?        @map("expiration_at")
  status             String           @default("active") @db.VarChar(32)
  lastNotifiedAt     DateTime?        @map("last_notified_at")
  lastError          String?          @map("last_error") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([provider, channelId])
  @@index([connectedAccountId, status])
  @@index([provider, status, expirationAt])
  @@map("provider_webhook_channels")
}

model FileShare {
  id        String    @id @default(uuid()) @db.Char(36)
  fileId    String    @map("file_id") @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  enabled   Boolean   @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@index([userId, enabled, createdAt])
  @@index([fileId, userId, enabled, createdAt])
  @@map("file_shares")
}

model FilePreviewToken {
  id        String   @id @default(uuid()) @db.Char(36)
  fileId    String   @map("file_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([userId])
  @@map("file_preview_tokens")
}

model Folder {
  id                 String            @id @default(uuid()) @db.Char(36)
  userId             String            @map("user_id") @db.Char(36)
  parentId           String?           @map("parent_id") @db.Char(36)
  connectedAccountId String?           @map("connected_account_id") @db.Char(36)
  provider           String            @default("google_drive") @db.VarChar(32)
  providerFolderId   String?           @map("provider_folder_id") @db.VarChar(191)
  name               String            @db.VarChar(255)
  color              String            @default("text-blue-500") @db.VarChar(64)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent             Folder?           @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children           Folder[]          @relation("FolderChildren")
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  files              File[]
  uploadSessions     UploadSession[]   @relation("UploadSessionFolder")

  @@index([userId])
  @@index([userId, deletedAt, updatedAt])
  @@index([userId, deletedAt, parentId, updatedAt])
  @@index([parentId])
  @@index([connectedAccountId])
  @@map("folders")
}

model UploadSession {
  id                       String            @id @default(uuid()) @db.Char(36)
  userId                   String            @map("user_id") @db.Char(36)
  targetConnectedAccountId String?           @map("target_connected_account_id") @db.Char(36)
  folderId                 String?           @map("folder_id") @db.Char(36)
  fileName                 String            @map("file_name") @db.VarChar(255)
  mimeType                 String            @map("mime_type") @db.VarChar(191)
  sizeBytes                BigInt            @map("size_bytes")
  status                   String            @db.VarChar(32)
  googleSessionUri         String?           @map("google_session_uri") @db.Text
  errorMessage             String?           @map("error_message") @db.Text
  createdAt                DateTime          @default(now()) @map("created_at")
  completedAt              DateTime?         @map("completed_at")
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetConnectedAccount   ConnectedAccount? @relation(fields: [targetConnectedAccountId], references: [id], onDelete: SetNull)
  folder                   Folder?           @relation("UploadSessionFolder", fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@map("upload_sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(191)
  entityType String   @map("entity_type") @db.VarChar(191)
  entityId   String?  @map("entity_id") @db.Char(36)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model WorkspaceInvite {
  id           String    @id @default(uuid()) @db.Char(36)
  inviterId    String    @map("inviter_id") @db.Char(36)
  inviteeEmail String    @map("invitee_email") @db.VarChar(191)
  targetType   String    @default("file") @map("target_type") @db.VarChar(32)
  targetId     String    @default("") @map("target_id") @db.Char(36)
  role         String    @default("viewer") @db.VarChar(32)
  status       String    @default("pending") @db.VarChar(32)
  revokedAt    DateTime? @map("revoked_at")
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  inviter      User      @relation("WorkspaceInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeEmail, targetType, targetId], map: "workspace_invites_target_unique")
  @@index([inviteeEmail])
  @@index([targetType, targetId])
  @@map("workspace_invites")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id") @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id
  issuer                String    @db.VarChar(191)
  accountId             String    @map("account_id") @db.VarChar(191)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.Char(36)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([issuer, accountId], map: "auth_accounts_issuer_account_id_uidx")
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

model VirtualFolder {
  id               String              @id @default(uuid()) @db.Char(36)
  userId           String              @map("user_id") @db.Char(36)
  name             String              @db.VarChar(100)
  color            String              @default("#1e9df1") @db.VarChar(64)
  thumbnailDataUrl String?             @map("thumbnail_data_url") @db.Text
  parentId         String?             @map("parent_id") @db.Char(36)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           VirtualFolder?      @relation("VirtualFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         VirtualFolder[]     @relation("VirtualFolderTree")
  items            VirtualFolderItem[]

  @@index([userId, parentId])
  @@map("virtual_folders")
}

model VirtualFolderItem {
  id                 String           @id @default(uuid()) @db.Char(36)
  virtualFolderId    String           @map("virtual_folder_id") @db.Char(36)
  connectedAccountId String           @map("connected_account_id") @db.Char(36)
  providerFileId     String           @map("provider_file_id") @db.VarChar(512)
  providerFolderId   String?          @map("provider_folder_id") @db.VarChar(512)
  name               String           @db.VarChar(255)
  mimeType           String           @default("application/octet-stream") @map("mime_type") @db.VarChar(191)
  sizeBytes          BigInt           @default(0) @map("size_bytes")
  kind               String           @default("file") @db.VarChar(16)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  virtualFolder      VirtualFolder    @relation(fields: [virtualFolderId], references: [id], onDelete: Cascade)
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([virtualFolderId, connectedAccountId, providerFileId])
  @@index([virtualFolderId])
  @@index([connectedAccountId])
  @@map("virtual_folder_items")
}
