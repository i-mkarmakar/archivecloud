# Generate secrets:
#   openssl rand -base64 32 | tr -d '\n' ; echo

DATABASE_URL=postgresql://postgres:archivecloud@archivecloud-db:5432/archivecloud

PORT=9050
NEXT_PUBLIC_APP_URL=http://localhost:9050
SITE_URL=http://localhost:9050
BETTER_AUTH_URL=http://localhost:9050
BETTER_AUTH_SECRET=change-this-better-auth-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes-min!
MAX_UPLOAD_BYTES=5368709120

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9050/connected-accounts/google/callback
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:9050/connected-accounts/google-photos/callback
GOOGLE_SHARED_DRIVE_REDIRECT_URI=http://localhost:9050/connected-accounts/google-shared-drive/callback

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:9050/connected-accounts/dropbox/callback

ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:9050/connected-accounts/onedrive/callback

PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
PCLOUD_REDIRECT_URI=http://localhost:9050/connected-accounts/pcloud/callback

RESEND_API_KEY=
RESEND_FROM_EMAIL=Archive Cloud <onboarding@resend.dev>

# Optional Cloudflare Turnstile (bot protection on public auth). Both required to enable.
# Dummy always-pass keys for local/dev (same set — do not mix with production keys):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Other Cloudflare dummies: 2x site/secret = always fail; 3x sitekey = forced interactive challenge.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# CRON_SECRET=
# WEBHOOK_BASE_URL=https://your-domain.com

# Whole-account catalog indexing (default off). When true, Dropbox accounts
# connected before Full Dropbox cutover show a reconnect banner.
# WHOLE_ACCOUNT_INDEXING_ENABLED=false
# Dropbox console access type: app (default) or full. Only "full" clears
# dropboxNeedsFullAccess on connect/reconnect.
# DROPBOX_ACCESS_TYPE=app
# Abort reconcile if it would soft-delete more than this % of an account's rows.
# INDEX_RECONCILE_MAX_REMOVAL_PCT=20
# Full-scan lock becomes resumable after this many minutes without a heartbeat.
# INDEX_SCAN_STALE_MINUTES=10

# Public share rate limits (metadata + download/preview byte routes).
# Public share rate limits (fixed window; counters stored in Postgres so all
# app replicas share the same limit). Token keys are hashed — raw tokens are
# never written to public_share_rate_buckets.
# PUBLIC_SHARE_RATE_LIMIT_PER_IP=120
# PUBLIC_SHARE_RATE_LIMIT_PER_TOKEN=60
# PUBLIC_SHARE_RATE_WINDOW_MS=60000
# Optional cookieless origin for public bytes (not wired yet).
# PUBLIC_FILES_ORIGIN=https://files.example.com
# Optional overrides for public-share daily bandwidth (bytes). Plan defaults apply when unset.
# SHARE_BANDWIDTH_DAILY_BYTES=
# SHARE_BANDWIDTH_DAILY_LINK_BYTES=

ADMIN_EMAIL=
ADMIN_NAME=
# DEFAULT_USER_PLAN=free

# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_SERVER=sandbox
# POLAR_PRODUCT_THUNDER_LIFETIME=
