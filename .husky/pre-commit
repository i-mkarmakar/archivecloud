#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo 'Running pre-commit checks...'

# Check format (Biome)
pnpm run check-format ||
(
  echo 'Format check failed. Please run "pnpm run format" and try again.'
  false
)

# Check lint (Biome)
pnpm run check-lint ||
(
  echo 'Lint check failed. Please fix the issues listed above and try again.'
  false
)

# Check TypeScript types
pnpm run check-types ||
(
  echo 'Type check failed. Please resolve the errors before committing.'
  false
)

# Build check
echo 'Building project to ensure stability...'
NODE_ENV=production pnpm run build ||
(
  echo 'Build failed. Please check the errors above and fix them before committing.'
  false
)

echo 'All checks passed! Proceeding with commit...'
