{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/src/generated/prisma",
      "!next-env.d.ts",
      "!**/public/**/*.svg"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "performance": {
        "noImgElement": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "googleapis": "Use Google Drive via src/server/modules/providers (or google modules under providers allowlist)."
            }
          }
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": [
        "src/server/modules/providers/google/**",
        "src/server/modules/providers/**",
        "src/server/modules/files/stream-google-file.ts",
        "src/server/modules/webhooks/google-drive-watch.ts",
        "src/server/modules/search/cross-cloud-search.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/views/**",
        "src/components/**",
        "src/hooks/**",
        "src/context/**",
        "src/layouts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "googleapis": "UI code must not import googleapis.",
                  "@/server/config/prisma": "UI code must not import Prisma.",
                  "@/lib/auth": "Use @/lib/auth-client in UI components."
                },
                "patterns": [
                  {
                    "group": ["@/server", "@/server/**"],
                    "message": "UI layers must not import @/server/*."
                  },
                  {
                    "group": ["@/generated/prisma", "@/generated/prisma/**"],
                    "message": "UI layers must not import the Prisma client."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "googleapis": "Keep Route Handlers thin; call handlers instead of googleapis.",
                  "@/server/config/prisma": "Do not use Prisma in route.ts; move logic into handlers."
                },
                "patterns": [
                  {
                    "group": ["@/generated/prisma", "@/generated/prisma/**"],
                    "message": "Do not use Prisma in Route Handlers."
                  },
                  {
                    "group": [
                      "@/server/modules/providers/google/**",
                      "@/server/modules/onedrive/**",
                      "@/server/modules/dropbox/**",
                      "@/server/modules/pcloud/**",
                      "@/server/modules/icloud/**"
                    ],
                    "message": "Route Handlers should call handlers/*, not provider services directly."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
